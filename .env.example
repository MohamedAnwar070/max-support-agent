# MaxWear Apparel Co. — Customer Support Agent Configuration
# Copy this file to .env if using OpenAI API. Do NOT commit real credentials.

# Execution backend: "hybrid" (default), "openai", or "claude_code"
SUPPORT_AGENT_BACKEND=hybrid

# Set to 1 to synthesize replies through live OpenAI API or Claude Code Pro CLI
USE_LIVE_LLM=0

# Optional: OpenAI API configuration (when SUPPORT_AGENT_BACKEND=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: Explicit path to Claude Code CLI binary (auto-discovered if omitted)
# CLAUDE_CLI_PATH=

